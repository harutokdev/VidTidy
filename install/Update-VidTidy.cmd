@rem Updates the VidTidy in this folder (downloads the latest installer; uses the local copy when offline). One line on purpose: "(goto)" ends the batch before the update replaces this file, and the rest of the line still runs.
@cd /d "%TEMP%" & set "VIDTIDY_DIR=%~dp0." & (goto) 2>nul & powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $ProgressPreference='SilentlyContinue'; [Net.ServicePointManager]::SecurityProtocol=[Net.ServicePointManager]::SecurityProtocol -bor 3072; $p=Join-Path $env:TEMP ('Install-VidTidy-'+[guid]::NewGuid().ToString('N')+'.ps1'); $a=@{}; if ($env:VIDTIDY_DIR) { $a.InstallDir=$env:VIDTIDY_DIR }; try { Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/harutokdev/VidTidy/releases/latest/download/Install-VidTidy.ps1' -OutFile $p } catch { $l=if ($env:VIDTIDY_DIR) { Join-Path $env:VIDTIDY_DIR 'Install-VidTidy.ps1' }; if ($l -and (Test-Path -LiteralPath $l)) { Copy-Item -LiteralPath $l -Destination $p } else { Write-Host ('Could not download the installer: '+$_.Exception.Message) -ForegroundColor Red; [void](Read-Host 'Press Enter to close'); exit 1 } }; try { & $p @a } finally { Remove-Item -LiteralPath $p -ErrorAction SilentlyContinue }; exit $LASTEXITCODE"
