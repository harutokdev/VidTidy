<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keyed pilot tokens; other workspaces opt in rather than changing implicit styles. -->
    <Style x:Key="VisualWorkspaceTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F5F8FC"/></Style>
    <Style x:Key="VisualSupportingText" TargetType="TextBlock"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#B9C9DB"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="VisualMainSurface" TargetType="Border"><Setter Property="Background" Value="#172B3C"/><Setter Property="BorderBrush" Value="#34516B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20"/></Style>
    <Style x:Key="VisualContextCard" TargetType="Border"><Setter Property="Background" Value="#112333"/><Setter Property="BorderBrush" Value="#304A62"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="14"/></Style>
    <Style x:Key="VisualEmptyState" TargetType="Border" BasedOn="{StaticResource VisualContextCard}"><Setter Property="BorderBrush" Value="#52647A"/><Setter Property="MinHeight" Value="130"/></Style>
    <Style x:Key="VisualCompactAlert" TargetType="Border"><Setter Property="Background" Value="#263023"/><Setter Property="BorderBrush" Value="#A87924"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Padding" Value="10"/></Style>
    <Style x:Key="VisualPrimaryButton" TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Background" Value="#0A65D8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#479BFF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="VisualSecondaryButton" TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#22384C"/><Setter Property="Foreground" Value="#EAF2FD"/><Setter Property="BorderBrush" Value="#4A6680"/></Style>
    <Style x:Key="VisualDestructiveButton" TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="40"/><Setter Property="Background" Value="#8F333A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#C5666B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="IsDefault" Value="False"/></Style>
    <Style x:Key="VisualStepperItem" TargetType="Border"><Setter Property="Background" Value="#23384B"/><Setter Property="BorderBrush" Value="#506B83"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/></Style>
</ResourceDictionary>
