<UserControl x:Class="LocalMediaAI.App.AiSearchWorkspace"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:LocalMediaAI.App.Localization"
 xmlns:local="clr-namespace:LocalMediaAI.App" SizeChanged="OnSizeChanged" PreviewKeyDown="OnKeyDown"
 AutomationProperties.Name="{l:T 'AI検索。検索語、順位順の結果、一致した根拠'}">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/><local:ThumbnailCacheImageConverter x:Key="Frame"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4EAF2"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </UserControl.Resources>
 <DockPanel Margin="4" KeyboardNavigation.TabNavigation="Local">
  <StackPanel DockPanel.Dock="Top" KeyboardNavigation.TabIndex="0">
   <TextBlock Text="{l:T 'AI検索'}" FontSize="20" FontWeight="SemiBold"/>
   <TextBlock Text="{l:T '探したい内容を自然言語で入力してください。例：海辺を走る犬'}" Margin="0,4"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="QueryInput" Text="{Binding SemanticSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,8,4" MinHeight="32" VerticalContentAlignment="Center"
     AutomationProperties.Name="{l:T 'AI検索の検索語'}" AutomationProperties.HelpText="{l:T '表示・検索・レビューの対象範囲は上部で変更できます。入力欄のEnterで検索します。'}"/>
    <Button x:Name="SearchButton" Grid.Column="1" Content="{l:T '検索'}" Command="{Binding SemanticSearchCommand}" IsEnabled="{Binding AiSearchCanSubmit}" AutomationProperties.Name="{l:T '入力した内容をAI検索'}"/>
    <Button Grid.Column="2" Content="{l:T 'キャンセル'}" Command="{Binding CancelSemanticSearchCommand}" Visibility="{Binding IsSemanticSearchBusy, Converter={StaticResource Visible}}"/>
   </Grid>
   <Expander Header="{l:T '追加条件：タグで絞り込む'}" IsExpanded="False"><WrapPanel>
    <TextBox Width="220" Text="{Binding TagFilterText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'AI検索の追加タグ条件'}" ToolTip="{l:T '固定のタグ名またはID。例：海、ocean'}"/>
    <CheckBox Content="{l:T 'AI提案タグを含む'}" IsChecked="{Binding TagFilterIncludeSuggested}" Margin="8,4"/>
    <TextBlock Text="{l:T 'タグ条件は次の検索時に適用します。順位を保って絞り込みます。AI提案タグは未確認の候補です。'}" VerticalAlignment="Center"/>
   </WrapPanel></Expander>
   <TextBlock Text="{Binding AiSearchStateMessage}" Margin="0,6" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="AiSearchLocalState"/>
   <TextBlock Text="{Binding AiSearchCapabilityMessage}" Foreground="#F7D58B" Visibility="{Binding IsWorkerUnavailable, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding AiSearchLocalFeedback}" Visibility="{Binding AiSearchHasFeedback, Converter={StaticResource Visible}}" AutomationProperties.LiveSetting="Polite"/>
   <Button Content="{l:T '絞り込みを解除して表示'}" Command="{Binding ClearLibraryFiltersAndRevealCommand}" Visibility="{Binding AiSearchCanClearLibraryFilters, Converter={StaticResource Visible}}" HorizontalAlignment="Left" AutomationProperties.Name="{l:T 'ライブラリの絞り込みを解除して表示。対象範囲は変更しません'}"/>
   <WrapPanel Visibility="{Binding AiSearchHasResults, Converter={StaticResource Visible}}"><CheckBox x:Name="EvidenceToggle" Content="{l:T '一致した根拠を確認'}" Checked="OnEvidenceToggle" Unchecked="OnEvidenceToggle" Margin="0,4" AutomationProperties.Name="{l:T '選択結果の根拠パネルを開閉'}"/></WrapPanel>
   <Expander local:DeveloperDiagnostics.Section="True" Header="{l:T '検索の技術情報'}" IsExpanded="False"><ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{Binding SemanticModelStatusText}"/><TextBlock Text="{Binding SemanticExecutionStatusText}"/><TextBlock Text="{Binding WorkerStatusText}"/>
    <TextBlock Text="{Binding SemanticSearchStatus}"/><TextBlock Text="{Binding ErrorText}"/>
    <TextBlock Text="{l:T '順位は既存の意味検索による比較順です。関連性の最低基準は設けず最大100件を返します。比較値は確率・信頼度・正解率ではありません。'}"/>
   </StackPanel></ScrollViewer></Expander>
  </StackPanel>
  <Grid x:Name="ResultsPanel" Visibility="{Binding AiSearchHasResults, Converter={StaticResource Visible}}" Margin="0,8,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="EvidenceColumn" Width="360"/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition x:Name="EvidenceRow" Height="Auto"/></Grid.RowDefinitions>
   <DataGrid x:Name="ResultsTable" ItemsSource="{Binding SemanticResults}" SelectedItem="{Binding SelectedSemanticResult}" LoadingRow="OnLoadingRow" AutoGenerateColumns="False"
    CanUserSortColumns="False" CanUserReorderColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
    EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
    KeyboardNavigation.TabIndex="0" AutomationProperties.Name="{l:T 'AI検索の順位順の結果'}" AutomationProperties.HelpText="{l:T '順位は左端の番号で表示します。矢印キーで選択、Enterで一致時刻からプレビューします。'}">
    <DataGrid.RowStyle><Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}"><Setter Property="AutomationProperties.Name" Value="{Binding FileName}"/><Setter Property="AutomationProperties.HelpText" Value="{Binding Path}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8FC5FF"/></Trigger>
    </Style.Triggers></Style></DataGrid.RowStyle>
    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Background" Value="#202833"/><Setter Property="Foreground" Value="#E4EAF2"/><Setter Property="BorderBrush" Value="#313B49"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#315B82"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8FC5FF"/><Setter Property="BorderThickness" Value="2"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
    <DataGrid.Columns>
     <DataGridTemplateColumn Header="{l:T '順位'}" Width="44"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Header, RelativeSource={RelativeSource AncestorType=DataGridRow}}" AutomationProperties.Name="{l:TBinding Header, RelativeSource={RelativeSource AncestorType=DataGridRow}, TFormat=検索順位 {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTemplateColumn Header="{l:T '一致フレーム'}" Width="94"><DataGridTemplateColumn.CellTemplate><DataTemplate><Grid Width="80" Height="46">
      <TextBlock Text="{l:T '画像未取得'}" FontSize="10"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4EAF2"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=RowMatchedFrame}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Image x:Name="RowMatchedFrame" Source="{Binding MatchedFrameRelativePath, Converter={StaticResource Frame}}" Stretch="Uniform" AutomationProperties.Name="{l:T '検索に使用された一致フレーム'}"/>
     </Grid></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="{l:T 'ファイル名'}" Binding="{Binding FileName}" Width="2*" MinWidth="140"/><DataGridTextColumn Header="{l:T '場所'}" Binding="{Binding Path}" Width="3*" MinWidth="160"/>
     <DataGridTextColumn Header="{l:T '一致時刻'}" Binding="{Binding TimestampDisplay}" Width="150"/>
    </DataGrid.Columns>
   </DataGrid>
   <Border x:Name="EvidencePanel" Grid.Column="1" Background="#1C222B" Padding="10" Margin="8,0,0,0" KeyboardNavigation.TabIndex="1">
    <DockPanel>
     <Button x:Name="BackToResults" DockPanel.Dock="Bottom" Content="{l:T '結果一覧に戻る'}" Click="ReturnToResults" Visibility="Collapsed"/>
     <WrapPanel DockPanel.Dock="Bottom" Visibility="{Binding AiSearchHasEvidence, Converter={StaticResource Visible}}">
      <Button Content="{l:T 'プレビュー'}" Command="{Binding AiSearchPreviewCommand}" AutomationProperties.Name="{l:T '選択結果の一致時刻からプレビュー'}"/>
      <Button Content="{l:T 'ライブラリで表示'}" Command="{Binding ShowAiSearchResultInLibraryCommand}" AutomationProperties.Name="{l:T '選択結果をメディアIDでライブラリに表示'}"/>
     </WrapPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" IsTabStop="False"><StackPanel>
      <TextBlock Text="{Binding SelectedSemanticResultFileName}" FontWeight="SemiBold" FontSize="17"/>
      <StackPanel Visibility="{Binding AiSearchHasEvidence, Converter={StaticResource Visible}}">
       <TextBlock Text="{Binding AiSearchEvidenceTime}" FontWeight="SemiBold"/>
       <TextBlock Text="{l:T '検索に使用された一致フレーム'}" Margin="0,4"/>
       <Grid><TextBlock Text="{l:T '一致フレームの画像は未取得です。ファイル名・場所とプレビューで確認できます。'}" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4EAF2"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=MatchedFrame}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <Image x:Name="MatchedFrame" Height="160" Source="{Binding SelectedSemanticResultFrame, Converter={StaticResource Frame}, ConverterParameter=Evidence}" Stretch="Uniform" AutomationProperties.Name="{l:T '選択結果の検索一致フレーム'}"/>
       </Grid>
       <TextBlock Text="{l:T '時刻は一致したサンプルの位置であり、場面の境界ではありません。'}" FontSize="11"/>
       <TextBlock Text="{Binding SelectedSemanticResultPath}" Margin="0,4"/><TextBlock Text="{Binding SelectedSemanticResult.DurationDisplay}"/>
       <Expander local:DeveloperDiagnostics.Section="True" Header="{l:T '選択結果の技術情報'}" IsExpanded="False"><StackPanel>
        <TextBlock Text="{Binding SelectedSemanticResultScore}"/><TextBlock Text="{l:T '比較値は検索順位用です。確率・信頼度・正解率ではありません。'}"/>
        <TextBlock Text="{Binding SelectedSemanticResult.MediaFileId, StringFormat=MediaFileId: {0}}"/>
        <TextBlock Text="{Binding SelectedSemanticResult.VisualSampleId, StringFormat=VisualSampleId: {0}}"/>
        <TextBlock Text="{Binding SelectedSemanticResult.VisualEmbeddingId, StringFormat=VisualEmbeddingId: {0}}"/>
        <TextBlock Text="{Binding SelectedSemanticHumanMetadata}"/>
       </StackPanel></Expander>
      </StackPanel>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
 </DockPanel>
</UserControl>
