                                <WrapPanel Margin="0,8,0,0" KeyboardNavigation.TabNavigation="Continue">
                                    <Button Command="{Binding RefreshCommand}" Content="{l:T '状態を更新'}" AutomationProperties.AutomationId="JobIssueRefresh" AutomationProperties.Name="{l:T '処理と問題の状態を更新'}">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedJobIssue.ShowRefreshAction}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                    <Button Command="{Binding RescanSelectedIssueRootCommand}" Content="{l:T '登録フォルダーを再スキャン'}" AutomationProperties.AutomationId="JobIssueRescanRoot" AutomationProperties.Name="{l:T '対象の登録フォルダーを再スキャン'}">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedJobIssue.CanRescan}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
