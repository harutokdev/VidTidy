                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding AccentBrush}" BorderThickness="3,0,0,0" Padding="6,3" Margin="1" AutomationProperties.Name="{Binding AutomationName}" AutomationProperties.HelpText="{Binding Meaning}">
