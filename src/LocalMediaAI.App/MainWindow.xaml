                        <TextBlock Text="{Binding JobIssueSummary}" Foreground="#B9C4D4" VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.AutomationId="JobIssueSummary"/>
                        <Expander local:DeveloperDiagnostics.Section="True" Header="{l:T '内部状態'}" IsExpanded="False" MaxWidth="300"><StackPanel><TextBlock Text="{Binding StatusText}"/><TextBlock Text="{Binding WorkerStatusText}"/></StackPanel></Expander>

                        <TextBlock Text="{l:T 'AI検索と新しいAI解析は現在利用できません。ライブラリの閲覧は続けられます。'}" Foreground="#F7D58B" Margin="10,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="IssueWorkerUnavailableImpact" AutomationProperties.Name="{l:T 'AI機能を利用できないことによる影響'}">
