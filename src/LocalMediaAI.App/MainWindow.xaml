                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{l:T '固定taxonomy: 海、山、都市、室内、夜景、車、犬、猫、人物、食べ物、スポーツ、自然、建物、画面/スライド、アニメーション。AI Suggested Tagは人間が確認する候補で、Duplicate・Probability・Confidenceではありません。'}" Foreground="#B9C4D4" FontSize="11" Margin="0,5,0,0"/>
            </Grid>
        </Border>
        <Expander x:Name="IssuesPane" DockPanel.Dock="Bottom" IsExpanded="False" MaxHeight="330" Margin="0,8,0,0" Background="#1C222B" BorderBrush="#313B49" BorderThickness="1" AutomationProperties.AutomationId="IssuesPane" AutomationProperties.Name="{l:T '処理と問題'}" AutomationProperties.HelpText="{l:T 'EnterまたはSpaceで開き、jobの利用者向け説明、既存action、技術情報を確認します。'}">
