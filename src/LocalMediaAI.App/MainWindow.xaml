                    <TextBlock Text="{l:T '最も近いサンプルです。場面の境界を示すものではありません。'}" Foreground="#F7D58B" FontSize="12"/>
                    <TextBlock Text="{l:T 'AI類似度（cosine）'}" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="{Binding SelectedSemanticResultScore}" Foreground="#8FC5FF" AutomationProperties.AutomationId="SelectedSemanticResultScoreValue" AutomationProperties.Name="{Binding SelectedSemanticResultScore}" AutomationProperties.HelpText="{l:T 'このモデル内の順位用比較値です。高いほど上位ですが、確率、confidence、正解率又は検索意図への一致保証ではありません。'}"/>
                    <TextBlock Text="{l:T '順位用の比較値です。確率・信頼度・正解率ではありません。プレビューで内容を確認してください。'}" Foreground="#B9C4D4" FontSize="11" TextWrapping="Wrap" AutomationProperties.AutomationId="SelectedSemanticScoreContext" AutomationProperties.Name="{l:T '選択結果のAI類似度の説明'}"/>
                    <TextBlock Text="{l:T '人が確認したメタデータ'}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SelectedSemanticHumanMetadata}" Foreground="#B9C4D4" TextWrapping="Wrap" AutomationProperties.Name="{l:T '検索結果のHuman-reviewed metadata'}" AutomationProperties.HelpText="{l:T '検索順位を変えずに、Human confirmed、Manual、Rejected、未確認AI Suggestedを区別して表示します。'}"/>
                    <Separator Margin="0,10"/>
                    </StackPanel>

                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <local:FileOperationWorkspace x:Name="ProgressiveOperationWorkspace"><local:FileOperationWorkspace.Style><Style TargetType="local:FileOperationWorkspace"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOperationWorkspaceOpen, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:FileOperationWorkspace.Style></local:FileOperationWorkspace>
        <local:LibraryWorkspace x:Name="MediaLibraryWorkspace"><local:LibraryWorkspace.Style><Style TargetType="local:LibraryWorkspace"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:LibraryWorkspace.Style></local:LibraryWorkspace>
        <local:AiSearchWorkspace x:Name="SearchFirstWorkspace"><local:AiSearchWorkspace.Style><Style TargetType="local:AiSearchWorkspace"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></local:AiSearchWorkspace.Style></local:AiSearchWorkspace>
        <local:ReviewWorkspace x:Name="EvidenceReviewWorkspace">
            <local:ReviewWorkspace.Style><Style TargetType="local:ReviewWorkspace"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding ReviewDetailedMode}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></local:ReviewWorkspace.Style>
        </local:ReviewWorkspace>
        <Border KeyboardNavigation.TabNavigation="Cycle" HorizontalAlignment="Center" VerticalAlignment="Center" Width="660" Background="#1C222B" Padding="16" BorderBrush="#8FC5FF" BorderThickness="2">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPreviewOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel AutomationProperties.AutomationId="PreviewContextPanel">
                <TextBlock Text="{l:T '読み取り専用プレビュー'}" FontSize="18"/>
                <WrapPanel><Button Command="{Binding SeekPreviewCommand}" Content="{l:T '選択時刻へ移動'}"/><Button Command="{Binding TogglePreviewPlaybackCommand}" Content="{l:T '再生 / 一時停止'}"/><Button x:Name="PreviewCloseButton" Command="{Binding ClosePreviewCommand}" Content="{l:T '閉じる'}"/></WrapPanel>
                <TextBlock Text="{Binding PreviewStatus}" AutomationProperties.AutomationId="PreviewStatus" AutomationProperties.LiveSetting="Polite"/>
                <MediaElement x:Name="PreviewMediaElement" Height="300" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" MediaOpened="PreviewMediaElement_OnMediaOpened" MediaFailed="PreviewMediaElement_OnMediaFailed" AutomationProperties.Name="{l:T '読み取り専用プレビュー'}"/>
                <TextBlock Text="{l:T '元のMediaは変更しません。ファイル操作の承認ではありません。'}"/>
            </StackPanel>
        </Border>
        </Grid>
    </DockPanel>
    <organize:OrganizeView x:Name="OrganizeScreen" Visibility="Collapsed" IsEnabled="{Binding DataContext.IsInteractionEnabled, ElementName=MainWindowRoot}"/>
    </Grid>
</Window>
