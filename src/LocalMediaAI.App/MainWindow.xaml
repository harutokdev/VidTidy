                </Expander>
            </Grid>
        </Border>
        <Border Visibility="Collapsed" DockPanel.Dock="Top" Style="{StaticResource AiSearchWorkspaceOnly}" Background="#1C222B" BorderBrush="#5E8E6B" BorderThickness="1" Padding="8" Margin="0,0,0,8" AutomationProperties.Name="{l:T 'タグ絞り込み'}">
