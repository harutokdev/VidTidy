<Window x:Class="LocalMediaAI.App.MainWindow" x:Name="MainWindowRoot"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:LocalMediaAI.App.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LocalMediaAI.App"
        xmlns:organize="clr-namespace:LocalMediaAI.App.Organize"
        local:DeveloperDiagnostics.Show="{Binding IsDeveloperMode}"
        xmlns:core="clr-namespace:LocalMediaAI.Core;assembly=LocalMediaAI.Core"
        mc:Ignorable="d" Title="VidTidy" Width="1540" Height="920" MinWidth="720" MinHeight="680"
        Background="#15191F" Foreground="#E8EDF4" PreviewKeyDown="Window_OnPreviewKeyDown" Closing="Window_OnClosing"
        AutomationProperties.Name="{l:T 'VidTidy メインウィンドウ'}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="ReviewVisible"/>
        <local:PresentationBindingProxy x:Key="DeveloperModeProxy" Value="{Binding IsDeveloperMode}"/>
        <local:LibraryDisplayConverter x:Key="GeneralDisplay"/>
        <local:FileSizeDisplayConverter x:Key="FileSizeDisplay"/>
        <local:ThumbnailCacheImageConverter x:Key="ThumbnailCacheImageConverter"/>
        <DataTemplate x:Key="UnifiedReviewFilterTemplate"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.All}"><Setter Property="Text" Value="{l:T 'すべて'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.Unreviewed}"><Setter Property="Text" Value="{l:T '未確認'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.Reviewed}"><Setter Property="Text" Value="{l:T '確認済み'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.ExactDuplicate}"><Setter Property="Text" Value="{l:T '完全一致'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.NearDuplicate}"><Setter Property="Text" Value="{l:T '類似重複'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.ContentSimilar}"><Setter Property="Text" Value="{l:T '内容の類似'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.SuggestedTag}"><Setter Property="Text" Value="{l:T '提案タグ'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.AvailableSourceOnly}"><Setter Property="Text" Value="{l:T '利用可能な元ファイル'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewFilter.MissingOrOfflineSource}"><Setter Property="Text" Value="{l:T '不明・オフライン'}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
        <DataTemplate x:Key="UnifiedReviewSortTemplate"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewSort.Priority}"><Setter Property="Text" Value="{l:T '優先度'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewSort.CreatedNewest}"><Setter Property="Text" Value="{l:T '新しい順'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewSort.MediaSizeDescending}"><Setter Property="Text" Value="{l:T 'サイズの大きい順'}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
        <DataTemplate x:Key="UnifiedReviewActionTemplate"><TextBlock><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Text" Value="{Binding}"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.ConfirmDuplicate}"><Setter Property="Text" Value="{l:T '完全一致を確認'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.ConfirmNearDuplicate}"><Setter Property="Text" Value="{l:T '類似重複を確認'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.KeepBoth}"><Setter Property="Text" Value="{l:T '両方を保持'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.Preferred}"><Setter Property="Text" Value="{l:T '優先ファイルにする'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.Ignore}"><Setter Property="Text" Value="{l:T '対象外'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.NotDuplicate}"><Setter Property="Text" Value="{l:T '重複ではない'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.Related}"><Setter Property="Text" Value="{l:T '関連あり'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.NotRelated}"><Setter Property="Text" Value="{l:T '関連なし'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.ConfirmTag}"><Setter Property="Text" Value="{l:T 'タグを確認'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.RejectTag}"><Setter Property="Text" Value="{l:T 'タグを却下'}"/></DataTrigger><DataTrigger Binding="{Binding}" Value="{x:Static core:UnifiedReviewAction.ResetToUnreviewed}"><Setter Property="Text" Value="{l:T '未確認に戻す'}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate>
        <Style x:Key="LibraryWorkspaceOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryWorkspaceButtonOnly" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryWorkspaceTextBlockOnly" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryWorkspaceListBoxOnly" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryWorkspaceDataGridOnly" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AiSearchWorkspaceOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AiSearchWorkspaceExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ReviewWorkspaceOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ReviewWorkspaceTabControlOnly" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
            <Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OperationsWorkspaceOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="3"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="OperationsWorkspaceExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="LibraryOrAiSearchOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LibraryOrReviewOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrowseReviewOrSearchOnly">
            <Setter Property="UIElement.Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"><Setter Property="UIElement.Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BrowseReviewOrSearchExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CenterWorkspacePanel" TargetType="Border">
            <Setter Property="Grid.Column" Value="1"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="1"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="2"/></DataTrigger>
                <DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="3"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ContextWorkspacePanel" TargetType="Border">
            <Setter Property="Grid.Column" Value="2"/>
            <Setter Property="Grid.ColumnSpan" Value="1"/>
            <Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="3"><Setter Property="Grid.Column" Value="0"/><Setter Property="Grid.ColumnSpan" Value="3"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ReviewUnifiedOnly"><Setter Property="UIElement.Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="UIElement.Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewDuplicatesOnly"><Setter Property="UIElement.Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="UIElement.Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewContentSimilarityOnly"><Setter Property="UIElement.Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="2"/></MultiDataTrigger.Conditions><Setter Property="UIElement.Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewSuggestedTagsOnly"><Setter Property="UIElement.Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="3"/></MultiDataTrigger.Conditions><Setter Property="UIElement.Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewUnifiedExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="0"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewDuplicatesExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="1"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewContentSimilarityExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="2"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReviewSuggestedTagsExpanderOnly" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding SelectedIndex, ElementName=TaskWorkspaceTabs}" Value="2"/><Condition Binding="{Binding SelectedIndex, ElementName=ReviewModeTabs}" Value="3"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style>
        <Style x:Key="ReadinessActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers><DataTrigger Binding="{Binding Readiness.HasAction}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
    <DockPanel x:Name="LegacyScreen" Margin="10" KeyboardNavigation.TabNavigation="Cycle" IsEnabled="{Binding IsInteractionEnabled}">
        <Button x:Name="BackToOrganizeButton" Visibility="Collapsed" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="2,0,0,8" Padding="12,6" Content="{l:T '← 新しい整理画面へ戻る'}" Click="BackToOrganize_OnClick" AutomationProperties.AutomationId="BackToOrganizeButton"/>
        <TabControl x:Name="TaskWorkspaceTabs" DockPanel.Dock="Top" Height="45" SelectedIndex="0" Margin="0,0,0,8" AutomationProperties.AutomationId="TaskWorkspaceTabs" AutomationProperties.Name="{l:T '作業領域の切り替え'}" AutomationProperties.HelpText="{l:T 'ライブラリ、AI検索、レビューを切り替えます。選択と絞り込みは同じセッション内で維持されます。'}">
            <TabControl.Style><Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding IsOperationWorkspaceOpen, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TabControl.Style>
            <TabItem Header="{l:T 'ライブラリ'}" AutomationProperties.AutomationId="LibraryWorkspaceTab" AutomationProperties.Name="{l:T 'ライブラリ'}"/>
            <TabItem Header="{l:T 'AI検索'}" AutomationProperties.AutomationId="AiSearchWorkspaceTab" AutomationProperties.Name="{l:T 'AI検索'}"/>
            <TabItem Header="{l:T 'レビュー'}" AutomationProperties.AutomationId="ReviewWorkspaceTab" AutomationProperties.Name="{l:T 'レビュー'}"/>
        </TabControl>
        <Button x:Name="OperationWorkspaceBackButton" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="2,0,0,8" Padding="12,7" Background="#24374B" BorderBrush="#54708E" Foreground="#E8EDF4" Content="{Binding OperationReturnLabel, ElementName=MainWindowRoot}" Click="OperationWorkspaceBack_OnClick" AutomationProperties.AutomationId="OperationWorkspaceBackButton" AutomationProperties.Name="{Binding OperationReturnLabel, ElementName=MainWindowRoot}">
            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsOperationWorkspaceOpen, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Border DockPanel.Dock="Top" Background="#1C222B" Padding="8,6" Margin="0,0,0,8" AutomationProperties.AutomationId="CurrentLibraryScope">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsOperationWorkspaceOpen, ElementName=MainWindowRoot}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{l:T '表示・検索・レビューの対象範囲'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Width="300" ItemsSource="{Binding LibraryScopeOptions}" SelectedItem="{Binding CurrentLibraryScope}" DisplayMemberPath="DisplayLabel" AutomationProperties.AutomationId="LibraryScopeSelector" AutomationProperties.Name="{l:T '現在のライブラリ対象範囲'}" AutomationProperties.HelpText="{l:T '表示・検索・レビュー候補だけを絞り込みます。スキャン、処理、保持期間、ファイル操作対象は変更しません。'}"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Top" Background="#202833" BorderBrush="{Binding Readiness.AccentBrush}" BorderThickness="2,1,1,1" Padding="8,6" Margin="0,0,0,8" MaxHeight="68" AutomationProperties.AutomationId="ReadinessBanner" AutomationProperties.Name="{l:T '現在対応が必要な状態と次の操作'}">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                <DataTrigger Binding="{Binding Readiness.State}" Value="NoRoot"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Readiness.State}" Value="RootNotSelected"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Readiness.State}" Value="RootOffline"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Readiness.State}" Value="ScanCompleteEmpty"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Readiness.State}" Value="RootReadyToScan"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Readiness.State}" Value="WorkerUnavailable"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding Readiness.State}" Value="UiError"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Readiness.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ReadinessTitle" AutomationProperties.Name="{Binding Readiness.Title}" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="{Binding Readiness.Meaning}" Foreground="#B9C4D4" FontSize="11" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="ReadinessMeaning" AutomationProperties.Name="{Binding Readiness.Meaning}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ReadinessActionButton}" Content="{Binding Readiness.ActionLabel}" Click="ReadinessAction_OnClick" Margin="12,0,0,0" VerticalAlignment="Center" AutomationProperties.AutomationId="ReadinessPrimaryAction" AutomationProperties.Name="{Binding Readiness.ActionLabel}" AutomationProperties.HelpText="{l:T '現在のReadiness状態に対応する既存の安全な操作またはworkspaceを開きます。'}"/>
            </Grid>
        </Border>
        <Border Visibility="Collapsed" DockPanel.Dock="Top" Style="{StaticResource LibraryWorkspaceOnly}" Background="#1C222B" BorderBrush="#313B49" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{l:T 'ライブラリ'}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1" TabIndex="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{l:T 'ファイル名、パス、コーデックを検索'}" AutomationProperties.Name="{l:T 'メディア検索'}" AutomationProperties.HelpText="{l:T 'ファイル名、パス、コーデックで検索します。'}"/>
                <Button Grid.Column="2" TabIndex="1" Command="{Binding RefreshCommand}" Content="{l:T '更新'}" AutomationProperties.Name="{l:T '一覧とジョブを更新'}"/>
                <Button Grid.Column="3" TabIndex="2" Command="{Binding RegisterRootCommand}" Content="{l:T 'フォルダーを登録'}" AutomationProperties.Name="{l:T 'ライブラリフォルダーを登録'}"/>
                <Button Grid.Column="4" TabIndex="3" Command="{Binding WorkerDiagnosticCommand}" Content="{l:T 'AI機能を診断'}" AutomationProperties.Name="{l:T 'Python Workerを診断'}" AutomationProperties.HelpText="{l:T 'Python Workerを必要時に起動し、HealthとVersionを確認します。'}"/>
                <Button Grid.Column="5" TabIndex="4" Command="{Binding UnregisterRootCommand}" Content="{l:T '登録解除'}" AutomationProperties.Name="{l:T '選択した登録フォルダーの登録を解除'}" AutomationProperties.HelpText="{l:T '元Mediaへ触れず、選択した登録フォルダーを保持期間付きで登録解除します。'}"/>
            </Grid>
        </Border>
        <Expander Visibility="Collapsed" DockPanel.Dock="Top" Style="{StaticResource LibraryWorkspaceOnly}" Header="{l:T '保持期間の設定'}" IsExpanded="False" Background="#1C222B" BorderBrush="#313B49" BorderThickness="1" Padding="8" Margin="0,0,0,8" AutomationProperties.AutomationId="RetentionSettings" AutomationProperties.Name="{l:T '保持期間の設定'}">
            <StackPanel>
                <TextBlock Text="{l:T '正の整数日数、または「無制限」。変更は保持中の対象にも適用され、保存時にはcleanupしません。'}" Foreground="#B9C4D4" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="File" VerticalAlignment="Center"/><TextBox Width="90" Margin="6,0,14,0" Text="{Binding FileRetentionText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'File保持日数'}"/>
                    <TextBlock Text="Folder" VerticalAlignment="Center"/><TextBox Width="90" Margin="6,0,14,0" Text="{Binding FolderRetentionText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'Folder保持日数'}"/>
                    <TextBlock Text="Drive" VerticalAlignment="Center"/><TextBox Width="90" Margin="6,0,14,0" Text="{Binding DriveRetentionText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{l:T 'Drive保持日数'}"/>
                    <Button Command="{Binding SaveRetentionSettingsCommand}" Content="{l:T '保存'}" AutomationProperties.Name="{l:T '保持期間を保存'}"/>
                </StackPanel>
            </StackPanel>
        </Expander>
        <Border Visibility="Collapsed" DockPanel.Dock="Top" Style="{StaticResource AiSearchWorkspaceOnly}" Background="#1C222B" BorderBrush="#386C9C" BorderThickness="1" Padding="8" Margin="0,0,0,8" AutomationProperties.Name="Semantic Visual Search">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{l:T 'AI意味検索'}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
