                    <Expander DockPanel.Dock="Bottom" Style="{StaticResource ReviewUnifiedExpanderOnly}" Header="{l:T '総合レビュー — 根拠の種類を分離し、人の判断はファイルを変更しません'}" IsExpanded="True" Margin="0,10,0,0" AutomationProperties.Name="Unified Review Queue" AutomationProperties.HelpText="{l:T 'Exact、Near Duplicate、Content Similarity、Suggested Tagを同じ優先順位キューで表示します。evidence scoreはtype別であり、cross-type confidenceではありません。Person reviewは含みません。'}">
