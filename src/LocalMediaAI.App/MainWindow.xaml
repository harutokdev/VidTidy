                <CheckBox Grid.Column="2" TabIndex="8" IsChecked="{Binding TagFilterIncludeSuggested}" Content="{l:T '提案タグを含む'}" Margin="10,0,4,0" VerticalAlignment="Center" AutomationProperties.Name="{l:T '提案タグを絞り込みに含める'}" AutomationProperties.HelpText="{l:T 'オフでは確認済みタグと手動タグだけを対象にします。'}"/>
