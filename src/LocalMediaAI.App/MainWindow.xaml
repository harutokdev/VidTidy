                                            <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,2"><TextBlock Text="{Binding Summary}" FontFamily="Consolas" FontSize="10"/><TextBlock Text="{Binding TechnicalDetail}" FontFamily="Consolas" FontSize="9" Foreground="#8F9BAD"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
