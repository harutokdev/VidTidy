                        <TextBlock Text="{l:T '処理を選択すると、何が起きたか、影響範囲、自動回復の有無、利用可能な既存actionを確認できます。複数の要確認項目がある場合は自動選択しません。'}" Foreground="#B9C4D4" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Border>
                    <Border x:Name="JobIssueDetail" Grid.Row="2" Grid.Column="1" Focusable="True" Padding="10" Background="#202833" BorderBrush="{Binding SelectedJobIssue.AccentBrush}" BorderThickness="2,1,1,1" AutomationProperties.AutomationId="JobIssueDetail" AutomationProperties.Name="{l:T '選択した履歴の詳細'}">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSelectedJobIssue}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedJobIssue.Title}" FontWeight="SemiBold" FontSize="15" AutomationProperties.AutomationId="JobIssueTitle"/>
                                <TextBlock Text="{Binding SelectedJobIssue.Meaning}" Margin="0,4,0,0" AutomationProperties.AutomationId="JobIssueMeaning"/>
