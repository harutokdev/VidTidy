                    <Border DockPanel.Dock="Bottom" Margin="0,6,0,6" Padding="6" Background="#3A2020" BorderBrush="#D98282" BorderThickness="1" AutomationProperties.AutomationId="SelectedOfflineRootDetail" AutomationProperties.Name="{l:T '選択した登録フォルダーはオフライン'}">
                        <Border.Style>
