<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measures analysis throughput on generated or explicitly supplied test media only.
       Every path it reads or writes is confined to the LocalMediaAI-TestLab folders; it never opens a production catalog. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\LocalMediaAI.Infrastructure\LocalMediaAI.Infrastructure.csproj" />
  </ItemGroup>
</Project>
